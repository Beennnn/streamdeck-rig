{
  "name": "streamdeck-rig",
  "version": "0.1.0",
  "description": "Show your live-rig readiness (readyset) on a Stream Deck and one-tap the fixes.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.beennnn.rig\"",
    "icons": "node assets/gen-icons.mjs",
    "validate": "streamdeck validate com.beennnn.rig.sdPlugin",
    "pack": "streamdeck pack com.beennnn.rig.sdPlugin --output dist --force"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.0.0",
    "rollup": "^4.24.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0"
  }
}
